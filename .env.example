# Copy to .env in the project root for local Docker Compose

# --- Backend (Railway Postgres) ---
DATABASE_URL=postgresql://postgres:password@hostname.railway.app:5432/railway
JWT_SECRET=change-in-production-use-a-long-random-string
RUN_MIGRATIONS=true
FRONTEND_URL=http://localhost:3000

# --- Frontend (local Docker only) ---
# Leave empty — nginx proxies /api to the backend container
VITE_API_URL=

# --- Railway production (set in Railway dashboard, not this file) ---
# Backend service (runtime):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   JWT_SECRET=<secret>
#   FRONTEND_URL=https://<frontend>.up.railway.app
#   RUN_MIGRATIONS=true
#
# Frontend service (build time, enable "Available at Build Time"):
#   VITE_API_URL=https://<backend>.up.railway.app
