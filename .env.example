# Copy to .env in the project root for local Docker Compose

# --- api service (Railway Postgres) ---
DATABASE_URL=postgresql://postgres:password@hostname.railway.app:5432/railway
JWT_SECRET=change-in-production-use-a-long-random-string
RUN_MIGRATIONS=true
PORT=8080
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- web service (Docker Compose build arg) ---
# Browser calls the api service on the host-mapped port
VITE_API_URL=http://localhost:8080

# --- Railway production (set in Railway dashboard) ---
# db: Postgres plugin → DATABASE_URL
#
# api service (runtime):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   JWT_SECRET=<secret>
#   FRONTEND_URL=https://<web>.up.railway.app
#   CORS_ORIGINS=https://<web>.up.railway.app
#   RUN_MIGRATIONS=true
#   PORT=8080
#
# web service (build time — Available at Build Time):
#   VITE_API_URL=https://<api>.up.railway.app
