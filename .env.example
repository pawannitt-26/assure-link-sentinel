# Copy to .env in the project root before running: docker compose up --build
#
# Railway Postgres: Project → your Postgres service → Connect → DATABASE_URL

# Required — Railway Postgres connection string
DATABASE_URL=postgresql://postgres:password@hostname.railway.app:5432/railway

# Required — min 16 characters
JWT_SECRET=change-in-production-use-a-long-random-string

# Run SQL migrations from db/migrations/ on backend startup (default: true)
RUN_MIGRATIONS=true

# CORS origin for the frontend (default matches docker-compose port mapping)
FRONTEND_URL=http://localhost:3000

# Optional — API URL for frontend build. Leave empty for Docker (uses /api via nginx).
# For local Vite dev without proxy: http://localhost:8001
VITE_API_URL=
