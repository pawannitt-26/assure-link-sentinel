# Server
NODE_ENV=development
PORT=8001
FRONTEND_URL=http://localhost:5173

# JWT (used by backend to sign session tokens for our /api/auth flow)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Supabase — required
# Project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=https://diyyqazmxisxylxofues.supabase.co
# Service role key (server-side ONLY — bypasses RLS). Get from Supabase dashboard → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Anon/publishable key (optional fallback for read-only ops)
SUPABASE_ANON_KEY=sb_publishable_6GzM165sQNnUD5jT4rwC5A_1ROygrw_

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info