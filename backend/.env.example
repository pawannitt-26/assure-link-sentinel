# Server
NODE_ENV=development
PORT=8001
FRONTEND_URL=http://localhost:3000

# JWT (used by backend to sign session tokens for our /api/auth flow)
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# PostgreSQL — Railway (Project → Postgres → Connect → DATABASE_URL)
DATABASE_URL=postgresql://postgres:password@hostname.railway.app:5432/railway

# Run SQL migrations from db/migrations/ on backend startup (default: true)
RUN_MIGRATIONS=true

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
